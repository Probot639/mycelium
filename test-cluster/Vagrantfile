Vagrant.configure("2") do |config|
  # Separate subnet for the cluster network so static IPs don't collide
  # with the management network (192.168.121.0/24 is already used by
  # vagrant-libvirt's DHCP for SSH access).
  config.vm.define "coord" do |node|
    node.vm.box = "generic/arch"
    node.vm.hostname = "coord"

    node.vm.synced_folder ".", "/vagrant", type: "rsync",
      rsync__exclude: [".git/", ".vagrant/"]

    node.vm.network "private_network", ip: "10.10.10.10"

    node.vm.provider :libvirt do |lv|
      lv.memory = 4096
      lv.cpus = 4
      lv.cpu_mode = "host-passthrough"
      lv.management_network_name = "vagrant-libvirt"
      lv.management_network_address = "192.168.121.0/24"
      lv.default_prefix = ""
    end

    node.vm.provision "shell", path: "provision-coord.sh"
  end

  config.vm.define "node1" do |node|
    node.vm.box = "generic/arch"
    node.vm.hostname = "node1"

    node.vm.synced_folder ".", "/vagrant", type: "rsync",
      rsync__exclude: [".git/", ".vagrant/"]

    node.vm.network "private_network", ip: "10.10.10.11"

    node.vm.provider :libvirt do |lv|
      lv.memory = 4096
      lv.cpus = 2
      lv.cpu_mode = "host-passthrough"
      lv.management_network_name = "vagrant-libvirt"
      lv.management_network_address = "192.168.121.0/24"
      lv.default_prefix = ""
    end

    node.vm.provision "shell", path: "provision-node.sh"
  end

  config.vm.define "node2" do |node|
    node.vm.box = "generic/arch"
    node.vm.hostname = "node2"

    node.vm.synced_folder ".", "/vagrant", type: "rsync",
      rsync__exclude: [".git/", ".vagrant/"]

    node.vm.network "private_network", ip: "10.10.10.12"

    node.vm.provider :libvirt do |lv|
      lv.memory = 4096
      lv.cpus = 2
      lv.cpu_mode = "host-passthrough"
      lv.management_network_name = "vagrant-libvirt"
      lv.management_network_address = "192.168.121.0/24"
      lv.default_prefix = ""
    end

    node.vm.provision "shell", path: "provision-node.sh"
  end
end
